# Django
DJANGO_SECRET_KEY=replace-with-strong-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=jidelna.kliknijidlo.cz
CSRF_TRUSTED_ORIGINS=https://jidelna.kliknijidlo.cz

# Database
DB_NAME=kliknijidlo
DB_USER=kliknijidlo_user
DB_PASSWORD=replace-with-strong-db-password

# SSL cert paths on NAS host
SSL_CERT_PATH=/etc/letsencrypt/live/jidelna.kliknijidlo.cz/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/jidelna.kliknijidlo.cz/privkey.pem

# Optional RFID bridge values (used only when profile rfid is enabled)
RFID_BRIDGE_PORT=3001
RFID_ALLOWED_ORIGINS=https://jidelna.kliknijidlo.cz
RFID_SERIAL_PORT=/dev/ttyUSB0
RFID_BAUD_RATE=9600
RFID_SERIAL_DEVICE=/dev/ttyUSB0

# Optional email
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
ADMIN_EMAIL=
